<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram name="Игра простыми словами" id="page1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1270" pageHeight="4892" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Начало" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="220" height="50" as="geometry"/></mxCell><mxCell id="n4" value="Открыть окно игры и включить 60 кадров/с&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;InitWindow(900, 550, &quot;Hangman&quot;);&lt;br&gt;SetTargetFPS(60);&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="340" height="80" as="geometry"/></mxCell><mxCell id="n5" value="Подготовить список слов и случайный выбор,&lt;br&gt;ошибок нет, игра не окончена&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;words = {&quot;programming&quot;, ...};&lt;br&gt;srand(time(0)); errors = 0;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="270" width="340" height="98" as="geometry"/></mxCell><mxCell id="n6" value="Начать новую игру: выбрать слово&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;NewGame(...);&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="418" width="340" height="62" as="geometry"/></mxCell><mxCell id="n7" value="Окно игры ещё не закрыто?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;!WindowShouldClose()&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="530" width="320" height="110" as="geometry"/></mxCell><mxCell id="n8" value="Игра окончена и нажата R?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;gameOver &amp;&amp; IsKeyPressed(KEY_R)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="690" width="320" height="110" as="geometry"/></mxCell><mxCell id="n9" value="Игра ещё идёт?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;!gameOver&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="850" width="320" height="110" as="geometry"/></mxCell><mxCell id="n10" value="Взять следующую нажатую клавишу&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;key = GetCharPressed();&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1010" width="340" height="62" as="geometry"/></mxCell><mxCell id="n11" value="Клавиша была нажата?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;key &gt; 0&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1122" width="320" height="110" as="geometry"/></mxCell><mxCell id="n12" value="Это английская буква?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;'A'..'Z' или 'a'..'z'&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1282" width="320" height="110" as="geometry"/></mxCell><mxCell id="n13" value="Сделать букву строчной&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;letter = tolower(key);&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1442" width="340" height="62" as="geometry"/></mxCell><mxCell id="n14" value="Эту букву уже называли?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;usedLetters.find(letter) != npos&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1554" width="320" height="110" as="geometry"/></mxCell><mxCell id="n15" value="Запомнить букву, пока считать, что её&lt;br&gt;в слове нет, начать с первой позиции&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;usedLetters += letter + &quot; &quot;;&lt;br&gt;found = false; i = 0;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1714" width="340" height="98" as="geometry"/></mxCell><mxCell id="n16" value="Остались непроверенные&lt;br&gt;позиции слова?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;i &lt; word.length()&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1862" width="320" height="110" as="geometry"/></mxCell><mxCell id="n17" value="Буква на позиции совпадает&lt;br&gt;с названной?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;word[i] == letter&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="2022" width="320" height="110" as="geometry"/></mxCell><mxCell id="n18" value="Открыть букву, отметить «найдена»&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;hidden[i] = letter;&lt;br&gt;found = true;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="2182" width="340" height="80" as="geometry"/></mxCell><mxCell id="n19" value="Перейти к следующей позиции&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;i++;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="2312" width="340" height="62" as="geometry"/></mxCell><mxCell id="n20" value="Такой буквы в слове нет?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;!found&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="2424" width="320" height="110" as="geometry"/></mxCell><mxCell id="n21" value="Добавить одну ошибку&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;errors++;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="2584" width="340" height="62" as="geometry"/></mxCell><mxCell id="n22" value="Ошибок шесть или больше?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;errors &gt;= 6&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="2696" width="320" height="110" as="geometry"/></mxCell><mxCell id="n23" value="Проигрыш: игра окончена&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;gameOver = true; win = false;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="2856" width="340" height="62" as="geometry"/></mxCell><mxCell id="n24" value="Все буквы слова открыты?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;hidden == word&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="2968" width="320" height="110" as="geometry"/></mxCell><mxCell id="n25" value="Взять следующую нажатую клавишу&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;key = GetCharPressed();&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="3128" width="340" height="62" as="geometry"/></mxCell><mxCell id="n26" value="Начать новую игру,&lt;br&gt;очистить очередь клавиш&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;NewGame(...);&lt;br&gt;ClearInputBuffer();&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="696" width="340" height="98" as="geometry"/></mxCell><mxCell id="n27" value="Победа: игра окончена&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;gameOver = true; win = true;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="2992" width="340" height="62" as="geometry"/></mxCell><mxCell id="n28" value="Начать рисование кадра, залить фон белым&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;BeginDrawing();&lt;br&gt;ClearBackground(RAYWHITE);&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="3310" width="340" height="80" as="geometry"/></mxCell><mxCell id="n29" value="Написать заголовок&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;DrawText(&quot;HANGMAN&quot;, ...);&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="3440" width="340" height="62" as="geometry"/></mxCell><mxCell id="n30" value="Нарисовать виселицу и человечка&lt;br&gt;по числу ошибок&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;DrawHangman(errors);&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="3552" width="340" height="80" as="geometry"/></mxCell><mxCell id="n31" value="Показать слово, названные буквы&lt;br&gt;и число ошибок&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;DrawText(hidden.c_str(), ...);&lt;br&gt;DrawText(usedLetters.c_str(), ...);&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="3682" width="340" height="98" as="geometry"/></mxCell><mxCell id="n32" value="Игра окончена?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;gameOver&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="3830" width="320" height="110" as="geometry"/></mxCell><mxCell id="n33" value="Игрок победил?&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;win&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="3990" width="320" height="110" as="geometry"/></mxCell><mxCell id="n34" value="Написать «Вы проиграли»&lt;br&gt;и показать слово&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;DrawText(&quot;YOU LOSE&quot;, ...);&lt;br&gt;DrawText(word.c_str(), ...);&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="4150" width="340" height="98" as="geometry"/></mxCell><mxCell id="n35" value="Подсказка: R — новая игра&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;DrawText(&quot;Press R to play again&quot;, ...);&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="4298" width="340" height="62" as="geometry"/></mxCell><mxCell id="n36" value="Закончить рисование кадра&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;EndDrawing();&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="4410" width="340" height="62" as="geometry"/></mxCell><mxCell id="n37" value="Закрыть окно игры&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;CloseWindow();&lt;br&gt;return 0;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="4612" width="340" height="80" as="geometry"/></mxCell><mxCell id="n38" value="Конец" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="4742" width="220" height="50" as="geometry"/></mxCell><mxCell id="n39" value="Подсказка: вводите буквы&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;DrawText(&quot;Type letters...&quot;, ...);&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="3854" width="340" height="62" as="geometry"/></mxCell><mxCell id="n40" value="Написать «Вы победили!»&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#555555&quot;&gt;DrawText(&quot;YOU WIN!&quot;, ...);&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="4014" width="340" height="62" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" x="-0.6" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;fontSize=12;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" x="-0.6" as="geometry"><