<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram name="Игра простыми словами" id="page1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="4332" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Начало" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="220" height="50" as="geometry"/></mxCell><mxCell id="n4" value="Открыть окно игры&lt;br&gt;и включить 60 кадров в секунду" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="300" height="62" as="geometry"/></mxCell><mxCell id="n5" value="Подготовить список из 15 слов&lt;br&gt;и включить случайный выбор&lt;br&gt;Ошибок нет, игра не окончена" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="252" width="300" height="80" as="geometry"/></mxCell><mxCell id="n6" value="Начать новую игру:&lt;br&gt;выбрать случайное слово" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="382" width="300" height="62" as="geometry"/></mxCell><mxCell id="n7" value="Окно игры&lt;br&gt;ещё не закрыто?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="494" width="300" height="110" as="geometry"/></mxCell><mxCell id="n8" value="Игра окончена&lt;br&gt;и игрок нажал R?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="654" width="300" height="110" as="geometry"/></mxCell><mxCell id="n9" value="Игра ещё идёт?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="814" width="300" height="110" as="geometry"/></mxCell><mxCell id="n10" value="Взять следующую&lt;br&gt;нажатую клавишу" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="974" width="300" height="62" as="geometry"/></mxCell><mxCell id="n11" value="Была ли&lt;br&gt;нажата клавиша?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1086" width="300" height="110" as="geometry"/></mxCell><mxCell id="n12" value="Это английская буква?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1246" width="300" height="110" as="geometry"/></mxCell><mxCell id="n13" value="Сделать букву строчной" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1406" width="300" height="50" as="geometry"/></mxCell><mxCell id="n14" value="Эту букву&lt;br&gt;уже называли?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1506" width="300" height="110" as="geometry"/></mxCell><mxCell id="n15" value="Запомнить букву как названную&lt;br&gt;Пока считать, что в слове её нет&lt;br&gt;Начать проверку с первой позиции" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1666" width="300" height="80" as="geometry"/></mxCell><mxCell id="n16" value="Остались ещё&lt;br&gt;непроверенные позиции в слове?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1796" width="300" height="110" as="geometry"/></mxCell><mxCell id="n17" value="Буква на этой позиции&lt;br&gt;совпадает с названной?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1956" width="300" height="110" as="geometry"/></mxCell><mxCell id="n18" value="Открыть эту букву в слове&lt;br&gt;Отметить: буква найдена" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2116" width="300" height="62" as="geometry"/></mxCell><mxCell id="n19" value="Перейти к следующей позиции" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2228" width="300" height="50" as="geometry"/></mxCell><mxCell id="n20" value="Такой буквы&lt;br&gt;в слове нет?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2328" width="300" height="110" as="geometry"/></mxCell><mxCell id="n21" value="Добавить одну ошибку" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2488" width="300" height="50" as="geometry"/></mxCell><mxCell id="n22" value="Ошибок стало&lt;br&gt;шесть или больше?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2588" width="300" height="110" as="geometry"/></mxCell><mxCell id="n23" value="Игра окончена:&lt;br&gt;проигрыш" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2748" width="300" height="62" as="geometry"/></mxCell><mxCell id="n24" value="Все буквы слова&lt;br&gt;открыты?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2860" width="300" height="110" as="geometry"/></mxCell><mxCell id="n25" value="Взять следующую&lt;br&gt;нажатую клавишу" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3020" width="300" height="62" as="geometry"/></mxCell><mxCell id="n26" value="Закрыть окно" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="524" width="300" height="50" as="geometry"/></mxCell><mxCell id="n27" value="Конец" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="524" width="220" height="50" as="geometry"/></mxCell><mxCell id="n28" value="Начать новую игру&lt;br&gt;и очистить очередь клавиш" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="678" width="300" height="62" as="geometry"/></mxCell><mxCell id="n29" value="Игра окончена:&lt;br&gt;победа" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="2884" width="300" height="62" as="geometry"/></mxCell><mxCell id="n30" value="Начать рисование кадра&lt;br&gt;Залить фон белым" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3202" width="300" height="62" as="geometry"/></mxCell><mxCell id="n31" value="Написать заголовок «HANGMAN»" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3314" width="300" height="50" as="geometry"/></mxCell><mxCell id="n32" value="Нарисовать виселицу и человечка&lt;br&gt;по числу ошибок" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3414" width="300" height="62" as="geometry"/></mxCell><mxCell id="n33" value="Показать слово с пропусками,&lt;br&gt;названные буквы и число ошибок" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3526" width="300" height="62" as="geometry"/></mxCell><mxCell id="n34" value="Игра окончена?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3638" width="300" height="110" as="geometry"/></mxCell><mxCell id="n35" value="Игрок победил?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3798" width="300" height="110" as="geometry"/></mxCell><mxCell id="n36" value="Написать «Вы проиграли»&lt;br&gt;и показать загаданное слово" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3958" width="300" height="62" as="geometry"/></mxCell><mxCell id="n37" value="Написать подсказку:&lt;br&gt;нажмите R для новой игры" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="4070" width="300" height="62" as="geometry"/></mxCell><mxCell id="n38" value="Закончить рисование кадра" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="4182" width="300" height="50" as="geometry"/></mxCell><mxCell id="n39